    "已有邮件正在打开，请稍后重试。" : {
      "comment" : "macOS 邮件反馈失败时展示给用户的错误说明。",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已有邮件正在打开，请稍后重试。"
          }
        },
        "ar" : {
          "stringUnit" : {
            "value" : "هناك رسالة بريد إلكتروني قيد الفتح بالفعل. حاول مرة أخرى لاحقًا.",
            "state" : "translated"
          }
        },
        "cs" : {
          "stringUnit" : {
            "value" : "Již se otevírá e-mail. Zkuste to později.",
            "state" : "translated"
          }
        },
        "de" : {
          "stringUnit" : {
            "value" : "Eine E-Mail wird bereits geöffnet. Bitte versuchen Sie es später erneut.",
            "state" : "translated"
          }
        },
        "en" : {
          "stringUnit" : {
            "value" : "An email is already opening. Please try again later.",
            "state" : "translated"
          }
        },
        "es" : {
          "stringUnit" : {
            "value" : "Ya se está abriendo un correo. Inténtalo de nuevo más tarde.",
            "state" : "translated"
          }
        },
        "fi" : {
          "stringUnit" : {
            "value" : "Sähköpostia avataan jo. Yritä myöhemmin uudelleen.",
            "state" : "translated"
          }
        },
        "fr" : {
          "stringUnit" : {
            "value" : "Un e-mail est déjà en cours d’ouverture. Réessayez plus tard.",
            "state" : "translated"
          }
        },
        "hu" : {
          "stringUnit" : {
            "value" : "Már folyamatban van egy e-mail megnyitása. Próbálja újra később.",
            "state" : "translated"
          }
        },
        "id" : {
          "stringUnit" : {
            "value" : "Email sedang dibuka. Coba lagi nanti.",
            "state" : "translated"
          }
        },
        "it" : {
          "stringUnit" : {
            "value" : "È già in corso l’apertura di un’email. Riprova più tardi.",
            "state" : "translated"
          }
        },
        "ja" : {
          "stringUnit" : {
            "value" : "メールを開いています。しばらくしてから再試行してください。",
            "state" : "translated"
          }
        },
        "ko" : {
          "stringUnit" : {
            "value" : "이미 이메일을 여는 중입니다. 잠시 후 다시 시도하세요.",
            "state" : "translated"
          }
        },
        "ms" : {
          "stringUnit" : {
            "value" : "E-mel sedang dibuka. Cuba lagi kemudian.",
            "state" : "translated"
          }
        },
        "nl" : {
          "stringUnit" : {
            "value" : "Er wordt al een e-mail geopend. Probeer het later opnieuw.",
            "state" : "translated"
          }
        },
        "pl" : {
          "stringUnit" : {
            "value" : "Trwa już otwieranie wiadomości e-mail. Spróbuj ponownie później.",
            "state" : "translated"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "value" : "Já está a ser aberto um e-mail. Tente novamente mais tarde.",
            "state" : "translated"
          }
        },
        "ru" : {
          "stringUnit" : {
            "value" : "Письмо уже открывается. Повторите попытку позже.",
            "state" : "translated"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "value" : "已有郵件正在開啟，請稍後重試。",
            "state" : "translated"
          }
        }
      }
    },
    "无法打开 Apple 邮件，请检查它是否已安装并配置账户。" : {
      "comment" : "macOS 邮件反馈失败时展示给用户的错误说明。",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法打开 Apple 邮件，请检查它是否已安装并配置账户。"
          }
        },
        "ar" : {
          "stringUnit" : {
            "value" : "تعذر فتح Apple Mail. تحقق من تثبيته وإعداد حساب فيه.",
            "state" : "translated"
          }
        },
        "cs" : {
          "stringUnit" : {
            "value" : "Nelze otevřít Apple Mail. Zkontrolujte, zda je nainstalovaný a má nastavený účet.",
            "state" : "translated"
          }
        },
        "de" : {
          "stringUnit" : {
            "value" : "Apple Mail kann nicht geöffnet werden. Prüfen Sie, ob es installiert und ein Account eingerichtet ist.",
            "state" : "translated"
          }
        },
        "en" : {
          "stringUnit" : {
            "value" : "Unable to open Apple Mail. Check that it is installed and an account is configured.",
            "state" : "translated"
          }
        },
        "es" : {
          "stringUnit" : {
            "value" : "No se puede abrir Apple Mail. Comprueba que esté instalado y tenga una cuenta configurada.",
            "state" : "translated"
          }
        },
        "fi" : {
          "stringUnit" : {
            "value" : "Apple Mailia ei voi avata. Tarkista, että se on asennettu ja tili on määritetty.",
            "state" : "translated"
          }
        },
        "fr" : {
          "stringUnit" : {
            "value" : "Impossible d’ouvrir Apple Mail. Vérifiez que l’app est installée et qu’un compte est configuré.",
            "state" : "translated"
          }
        },
        "hu" : {
          "stringUnit" : {
            "value" : "Az Apple Mail nem nyitható meg. Ellenőrizze, hogy telepítve van-e, és be van-e állítva egy fiók.",
            "state" : "translated"
          }
        },
        "id" : {
          "stringUnit" : {
            "value" : "Tidak dapat membuka Apple Mail. Pastikan aplikasi terpasang dan akun telah dikonfigurasi.",
            "state" : "translated"
          }
        },
        "it" : {
          "stringUnit" : {
            "value" : "Impossibile aprire Apple Mail. Verifica che sia installato e che un account sia configurato.",
            "state" : "translated"
          }
        },
        "ja" : {
          "stringUnit" : {
            "value" : "Appleのメールを開けません。インストールされ、アカウントが設定されているか確認してください。",
            "state" : "translated"
          }
        },
        "ko" : {
          "stringUnit" : {
            "value" : "Apple Mail을 열 수 없습니다. 설치 여부와 계정 설정을 확인하세요.",
            "state" : "translated"
          }
        },
        "ms" : {
          "stringUnit" : {
            "value" : "Tidak dapat membuka Apple Mail. Pastikan aplikasi dipasang dan akaun dikonfigurasikan.",
            "state" : "translated"
          }
        },
        "nl" : {
          "stringUnit" : {
            "value" : "Kan Apple Mail niet openen. Controleer of het is geïnstalleerd en een account is ingesteld.",
            "state" : "translated"
          }
        },
        "pl" : {
          "stringUnit" : {
            "value" : "Nie można otworzyć Apple Mail. Sprawdź, czy aplikacja jest zainstalowana i ma skonfigurowane konto.",
            "state" : "translated"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "value" : "Não foi possível abrir o Apple Mail. Verifique se está instalado e se tem uma conta configurada.",
            "state" : "translated"
          }
        },
        "ru" : {
          "stringUnit" : {
            "value" : "Не удалось открыть Apple Mail. Проверьте, установлено ли приложение и настроена ли учётная запись.",
            "state" : "translated"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
