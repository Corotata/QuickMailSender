    "已提交，请稍后核对邮件是否发送成功。" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم الإرسال. يرجى التحقق لاحقًا مما إذا كان البريد الإلكتروني قد أُرسل بنجاح."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odesláno, zkontrolujte později, zda byl e-mail úspěšně odeslán."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gesendet. Bitte später überprüfen, ob die E-Mail erfolgreich gesendet wurde."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Submitted. Please check later if the email was successfully sent."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enviado, por favor revisa más tarde si el correo se envió correctamente."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lähetetty, tarkista sähköpostin toimitus myöhemmin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soumis. Veuillez vérifier plus tard si l'email a été envoyé avec succès."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beküldve, később ellenőrizze, hogy sikeres volt-e az e-mail küldése."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Telah dikirim, silakan cek nanti apakah email berhasil terkirim."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inviato. Si prega di verificare più tardi se l'email è stata inviata con successo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "送信済みです。後ほどメールが正常に送信されたかご確認ください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "제출되었습니다. 이메일 전송 여부를 잠시 후 확인해주세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Telah dihantar. Sila periksa kemudian sama ada e-mel berjaya dihantar."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingediend, controleer later of de e-mail succesvol is verzonden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zgłoszono. Proszę sprawdzić później, czy e-mail został wysłany pomyślnie."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Submetido, verifique mais tarde se o e-mail foi enviado com sucesso."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отправлено. Пожалуйста, проверьте позже, успешно ли отправлено письмо."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已提交，请稍后核对邮件是否发送成功。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已提交，請稍後確認郵件是否發送成功。"
          }
        }
      }
