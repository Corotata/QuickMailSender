    "设备信息已复制到剪贴板，请在此处粘贴。\n\n" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم نسخ معلومات الجهاز إلى الحافظة. يُرجى لصقها هنا.\n\n"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Informace o zařízení byly zkopírovány do schránky, vložte je prosím zde.\n\n"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Geräteinformationen wurden in die Zwischenablage kopiert. Bitte hier einfügen.\n\n"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Device information has been copied to the clipboard. Please paste it here.\n\n"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La información del dispositivo se ha copiado al portapapeles. Pégala aquí.\n\n"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laitetiedot on kopioitu leikepöydälle. Liitä ne tähän.\n\n"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les informations de l’appareil ont été copiées dans le presse-papiers. Veuillez les coller ici.\n\n"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az eszközadatok a vágólapra kerültek. Kérjük, illessze be ide.\n\n"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Informasi perangkat telah disalin ke papan klip. Silakan tempelkan di sini.\n\n"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le informazioni del dispositivo sono state copiate negli appunti. Incollale qui.\n\n"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デバイス情報をクリップボードにコピーしました。ここに貼り付けてください。\n\n"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기기 정보가 클립보드에 복사되었습니다. 여기에 붙여넣어 주세요.\n\n"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maklumat peranti telah disalin ke papan klip. Sila tampal di sini.\n\n"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De apparaatgegevens zijn naar het klembord gekopieerd. Plak ze hier.\n\n"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Informacje o urządzeniu zostały skopiowane do schowka. Wklej je tutaj.\n\n"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As informações do dispositivo foram copiadas para a área de transferência. Cole-as aqui.\n\n"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Информация об устройстве скопирована в буфер обмена. Вставьте её здесь.\n\n"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
